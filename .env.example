# Copy to .env, chmod 600. Avoid $ # " ' \ ` in values (Docker Compose interpolation).

# IMPORTANT: Every change in this file requires a 'docker compose up -d' to get active!

# API Key to be used in your LLM frontend (e.g. Open WebUI -> Integrations -> Tools -> External Tool Servers)
WIREHAND_API_KEY=change-me-long-random-string

# How a staged change gets approved before confirm_change applies it:
#   totp (default) - the user must read a 6-digit one-time code from an authenticator
#                    app and give it to the model. A model cannot produce that number,
#                    so it cannot confirm its own proposal.
#   off            - no approval; the model may apply what it just proposed.
# Per device this can be overridden with `confirm: totp|off` in config/inventory.yaml
# (e.g. off for disposable lab nodes, totp for anything real).
WIREHAND_CONFIRM_MODE=totp

# Shared secret for the one-time codes; required when the mode is totp.
# Generate one and get the QR/URI for your authenticator app with:
#   docker exec wirehand python -m app.approval --new
WIREHAND_TOTP_SECRET=
# Seconds a code is still accepted after the authenticator app stopped showing it.
# Slow (local) models may think for minutes before calling confirm_change - raise if needed.
WIREHAND_APPROVAL_MAX_AGE=120

# Timeouts in seconds (optional - the defaults shown apply when unset). See
# "Timeouts and unknown outcomes" in the README. Keep each per-step limit below its
# deadline, and the front-end's tool timeout ABOVE the deadlines, or it gives up first.
#WIREHAND_DEADLINE_READ=60        # whole run_read / get_facts call -> 504
#WIREHAND_DEADLINE_PROPOSE=60     # whole propose_change / rollback_change call -> 504
#WIREHAND_DEADLINE_CONFIRM=60     # whole confirm_change call -> 504 OUTCOME UNKNOWN
#WIREHAND_LOCK_WAIT=20            # wait for another call on the same device -> 409
#WIREHAND_CMD_TIMEOUT=45          # one read command
#WIREHAND_CHANGE_CMD_TIMEOUT=45   # one change step (command, config lines, commit)

# Snapshot cleanup per device (optional - the defaults shown apply when unset). 0 switches
# a rule off. Never removed: the snapshot of the last applied change, and snapshots of
# changes that are still pending or whose outcome is unknown. See "Audit log & snapshots".
#WIREHAND_SNAPSHOT_KEEP=20            # max snapshots per device, oldest removed first
#WIREHAND_SNAPSHOT_MAX_AGE_DAYS=90    # max age of any snapshot
#WIREHAND_SNAPSHOT_UNAPPLIED_DAYS=7   # max age of a snapshot whose change was never applied

# Host folder that contains your containerlab topologies (scanned recursively for clab-*/ dirs).
WIREHAND_CLAB_DIR=/path/to/containerlabs

# Credentials for MANUAL devices in config/inventory.yaml (env:VARNAME references)
LAB_SRV1_USER=netops
LAB_SRV1_PASS=...
# Optional overrides for containerlab kinds that have no credentials in the generated inventory
FGT_PASS=...
