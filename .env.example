# Copy to .env, chmod 600. Avoid $ # " ' \ ` in values (Docker Compose interpolation).
WIREHAND_API_KEY=change-me-long-random-string

# How a staged change gets approved before confirm_change applies it:
#   totp (default) - the user must read a 6-digit one-time code from an authenticator
#                    app and give it to the model. A model cannot produce that number,
#                    so it cannot confirm its own proposal.
#   off            - no approval; the model may apply what it just proposed.
# Per device this can be overridden with `confirm: totp|off` in config/inventory.yaml
# (e.g. off for disposable lab nodes, totp for anything real).
WIREHAND_CONFIRM_MODE=totp

# Shared secret for the one-time codes; required when the mode is totp.
# Generate one and get the QR/URI for your authenticator app with:
#   docker exec wirehand python -m app.approval --new
WIREHAND_TOTP_SECRET=
# Seconds a code is still accepted after the authenticator app stopped showing it.
# Slow (local) models may think for minutes before calling confirm_change - raise if needed.
WIREHAND_APPROVAL_MAX_AGE=120

# Host folder that contains your containerlab topologies (scanned recursively for clab-*/ dirs).
WIREHAND_CLAB_DIR=/home/stephan/containerlabs

# Credentials for MANUAL devices in config/inventory.yaml (env:VARNAME references)
LAB_SRV1_USER=netops
LAB_SRV1_PASS=...
# Optional overrides for containerlab kinds that have no credentials in the generated inventory
FGT_PASS=...
