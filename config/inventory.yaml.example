# ----------------------------------------------------------------------------
# Manual devices. list_devices shows the LLM: name, platform, access, confirm
# (effective mode), mgmt IP, description. Tags are not shown.
# Credentials: env:VARNAME -> resolved from the container environment (.env);
#              works for username, password and secret.
# access: ro (default) | rw.
# confirm: totp | off - who may approve a change on this device. Default comes from
#          WIREHAND_CONFIRM_MODE; 'off' lets the model confirm its own proposal, so
#          use it only for disposable devices.
# device_type = Netmiko driver: linux, cisco_ios, cisco_xe, cisco_xr, cisco_nxos,
#               huawei, huawei_vrpv8, fortinet, arista_eos, juniper_junos
# A manual entry with the same name as a discovered containerlab node overrides it.
# ----------------------------------------------------------------------------
devices:
  lab-srv1:
    host: 192.0.2.10
    device_type: linux
    username: env:LAB_SRV1_USER
    password: env:LAB_SRV1_PASS
    access: rw
    # confirm: off            # disposable device - the model may confirm its own proposal
    description: Ubuntu lab VM (change testing target)
    tags: [lab, linux]

  # Every remaining key, on one device. Defaults: port 22, timeout 30, access ro,
  # confirm inherited from WIREHAND_CONFIRM_MODE.
  # core-sw1:
  #   host: 192.0.2.20
  #   device_type: cisco_ios
  #   username: env:CORE_SW1_USER
  #   password: env:CORE_SW1_PASS
  #   secret: env:CORE_SW1_ENABLE  # enable password; used where config/platforms/ sets session.enable
  #   port: 2222                   # SSH port (default 22)
  #   timeout: 60                  # Netmiko 'timeout'; over SSH practically no effect (default 30).
  #                                # Command and call limits are WIREHAND_CMD_TIMEOUT and
  #                                # WIREHAND_DEADLINE_* (docker-compose.yml)
  #   access: ro
  #   confirm: totp
  #   description: Core switch building A
  #   tags: [prod, campus]

# ----------------------------------------------------------------------------
# Containerlab discovery (folder set via WIREHAND_CLAB_DIR). Every deployed lab
# (clab-<name>/ansible-inventory.yml) is scanned; nodes are named <lab>-<node>,
# e.g. xrd-test-xrd1. Destroyed labs disappear within WIREHAND_CLAB_RESCAN seconds.
# Discovered nodes are not listed in this file, so the defaults below (or the
# per-kind overrides) are the only place to set access/confirm for them.
# ----------------------------------------------------------------------------
containerlab:
  default_access: rw          # labs are disposable; set ro if you prefer the cautious default
  # default_confirm: off      # totp | off for discovered nodes; omit to inherit
                              # WIREHAND_CONFIRM_MODE. Uncomment to let the model apply
                              # its own proposals on lab nodes without a one-time code.
  long_names: false           # true -> use full names like clab-xrd-test-xrd1

  # kind -> Netmiko driver / access / confirm overrides; these beat the two defaults
  # above (the shipped map is the containerlab.kinds of config/platforms/*.yaml:
  # cisco_xrd, cisco_iol, huawei_vrp, fortinet_fortigate, arista_ceos, juniper_vjunos*,
  # linux, ...)
  kinds:
    huawei_vrp: { device_type: huawei_vrpv8 }     # NE40E/CE = VRP8; use 'huawei' for VRP5 images
    # cisco_xrd: { access: ro, confirm: totp }

  # credentials per kind when the generated ansible inventory has none, or to override it
  credentials:
    fortinet_fortigate: { username: admin, password: env:FGT_PASS }
    # cisco_xrd: { username: clab, password: clab@123 }    # containerlab default, already built in
